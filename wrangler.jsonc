{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "pilas-acopio-stock",

  "main": "src/index.js",

  "compatibility_date": "2026-08-03",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  "secrets": [
    "DROPBOX_ACOPIO_URL",
    "DROPBOX_STOCK_URL"
  ]
}
